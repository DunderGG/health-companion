# Set default behavior to automatically normalize line endings to LF in the repo
* text=auto eol=lf

# Ensure shell scripts always retain LF line endings (critical for Linux, macOS, and CI runners)
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code & configs
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binary files (never modify line endings)
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.so binary

