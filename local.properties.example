## Copy this file to local.properties and set the sdk.dir value to your local Android SDK path.
## local.properties is excluded from version control (see .gitignore).
#
# Location of the SDK. This is only used by Gradle.
# For customization when using a Version Control System, please read the header note.

# macOS / Linux example:
# sdk.dir=/Users/your-username/Library/Android/Sdk

# Windows example:
# sdk.dir=C\:\\Users\\your-username\\AppData\\Local\\Android\\Sdk

